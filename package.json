{
  "name": "celeste-ai",
  "version": "0.2.32",
  "description": "DeFAI chat UI for Celo — applied Celina, a third-party, open-source Celo agent stack (SDK, MCP server, REST API). Connect a wallet, ask about balances, and prepare sends, swaps (Mento FX + Uniswap v4), and Aave actions — you sign in your wallet.",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "vitest run",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache",
    "deploy:response-store": "wrangler deploy --config wrangler.response-store.jsonc"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/react": "^3.0.193",
    "@amplitude/analytics-browser": "^2.43.0",
    "@amplitude/analytics-node": "^1.3.8",
    "@andrewkimjoseph/celina-sdk": "0.26.5",
    "@cloudflare/workers-response-store": "^0.1.0-beta.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.100.14",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "ai": "^6.0.191",
    "dexie": "^4.4.3",
    "next": "16.2.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "viem": "^2.51.0",
    "vinext": "^1.0.0-beta.10",
    "wagmi": "^2.19.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  },
  "overrides": {
    "qr": "0.5.5"
  },
  "type": "module"
}
