{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celeste-ai",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "cache": {
    "enabled": false
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "celeste.usecelina.xyz",
      "custom_domain": true
    }
  ]
}
