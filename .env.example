# OpenRouter (recommended if you use OpenRouter)
OPENROUTER_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini
# Optional OpenRouter metadata
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_NAME=Celeste

# Direct OpenAI (alternative — omit OPENROUTER_API_KEY)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Override provider base URL (optional; OpenRouter default is https://openrouter.ai/api/v1)
# OPENAI_BASE_URL=

CELO_RPC_URL_MAINNET=https://forno.celo.org
ETH_RPC_URL_MAINNET=https://ethereum.publicnode.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
